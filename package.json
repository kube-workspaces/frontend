{
  "name": "frontend",
  "version": "0.2.0",
  "private": true,
  "scripts": {
    "dev": "NODE_OPTIONS='--no-deprecation' node server.mjs",
    "dev:raw": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "npm run test:node && npm run test:unit",
    "test:node": "node --experimental-strip-types --test src/lib/*.test.mjs",
    "test:unit": "vitest run",
    "test:browser": "playwright test",
    "pwa:screenshots": "UPDATE_PWA_SCREENSHOTS=1 playwright test tests/browser/pwa.spec.ts --grep signed-in",
    "postinstall": "patch-package"
  },
  "dependencies": {
    "@novnc/novnc": "1.7.0",
    "@tailwindcss/typography": "^0.5.20",
    "@types/d3": "^7.4.3",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "d3": "^7.9.0",
    "dotenv": "^17.4.2",
    "next": "^16.2.10",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-markdown": "^10.1.0",
    "recharts": "^3.9.2",
    "remark-gfm": "^4.0.1",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.2",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.2.10",
    "http-proxy": "^1.18.1",
    "jsdom": "^29.1.1",
    "patch-package": "^8.0.0",
    "tailwindcss": "^4.3.2",
    "typescript": "^6.0.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "postcss": "^8.5.23",
    "nanoid": "^3.3.17",
    "js-yaml": "^4.3.1",
    "sharp": "^0.35.3"
  },
  "allowScripts": {
    "sharp": true,
    "unrs-resolver": true
  }
}
